Output docs/demo.gif

Set Shell "bash"
Set FontSize 24
Set Width 1200
Set Height 700
Set Theme "Dracula"

Type "echo uigen - Write UI logic once deploy anywhere" Sleep 500ms Enter
Sleep 2s
Type "clear" Sleep 200ms Enter
Sleep 500ms

Type "echo The Problem: 35+ lines of HTML for a table" Sleep 500ms Enter
Sleep 2s
Type "clear" Sleep 200ms Enter
Sleep 500ms

Type "echo The Solution: 15 lines of Python" Sleep 500ms Enter
Sleep 1s
Type "echo from uigen import App Model ui" Sleep 100ms Enter
Type "echo class User(Model):" Sleep 100ms Enter
Type "echo     name: str" Sleep 100ms Enter
Type "echo     email: str" Sleep 100ms Enter
Type "echo     role: str = viewer" Sleep 100ms Enter
Type "echo app.render(lnative output=./dist)" Sleep 100ms Enter
Sleep 3s
Type "clear" Sleep 200ms Enter
Sleep 500ms

Type "echo Result: 57 percent less code" Sleep 500ms Enter
Sleep 1s
Type "echo Lines:  35+ to 15" Sleep 100ms Enter
Type "echo Chars:  1500 to 500" Sleep 100ms Enter
Type "echo Time:   10-15 min to 2-3 min" Sleep 100ms Enter
Sleep 2s
Type "clear" Sleep 200ms Enter
Sleep 500ms

Type "echo 4 Renderers" Sleep 500ms Enter
Sleep 1s
Type "echo lnative - Static HTML CSS JS" Sleep 100ms Enter
Type "echo lreact  - React components" Sleep 100ms Enter
Type "echo lflask  - Flask Jinja2 templates" Sleep 100ms Enter
Type "echo ldjango - Django templates" Sleep 100ms Enter
Sleep 3s
Type "clear" Sleep 200ms Enter
Sleep 500ms

Type "echo Get Started" Sleep 500ms Enter
Sleep 1s
Type "echo pip install uigen" Sleep 100ms Enter
Type "echo uigen init my-app" Sleep 100ms Enter
Type "echo cd my-app" Sleep 100ms Enter
Type "echo python main.py" Sleep 100ms Enter
Sleep 3s
Type "clear" Sleep 200ms Enter
Sleep 500ms

Type "echo github.com/SaadEddine-ware/uigen" Sleep 500ms Enter
Sleep 2s
